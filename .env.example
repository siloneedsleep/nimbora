# Database (Neon/PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth — bắt buộc, không có default. Tạo bằng: openssl rand -hex 32
JWT_SECRET=""

# Mã hoá API key của user trước khi lưu DB — bắt buộc, 32 byte hex.
# Tạo bằng: openssl rand -hex 32
# LƯU Ý: phải KHÁC JWT_SECRET.
ENCRYPTION_KEY=""

# Setup 2 tài khoản cố định (Owner + Official), gọi 1 lần lúc deploy:
#   curl -X POST https://your-domain/api/setup -H "x-setup-token: $SETUP_TOKEN"
# Sau khi setup xong, nên unset SETUP_TOKEN để khoá route lại.
SETUP_TOKEN=""
OWNER_USERNAME="siloneedsleep"
OWNER_PASSWORD=""
OFFICIAL_USERNAME="mioo"
OFFICIAL_PASSWORD=""

NODE_ENV="development"
